# 统一换行符，避免跨平台 diff 噪声
* text=auto eol=lf

# 明确文本类型
*.md      text eol=lf
*.txt     text eol=lf
*.py      text eol=lf
*.c       text eol=lf
*.h       text eol=lf
*.cpp     text eol=lf
*.ino     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.csv     text eol=lf
*.kicad_sch text
*.kicad_pcb text
.gitignore  text eol=lf
.gitattributes text eol=lf

# 二进制文件
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.docx    binary
*.pptx    binary
*.xlsx    binary
*.wav     binary
*.mp3     binary
*.bin     binary
*.tflite  binary
